# LUXCode — free local AI on Windows (browser)
# Copy to .env.local:  copy .env.free-local.example .env.local
#
# No paid API keys required when using Ollama (fully local).
# Hugging Face is optional (free tier with a token from huggingface.co/settings/tokens).

NODE_ENV=development
PORT=5173
VITE_LOG_LEVEL=info

# --- Local models (free, run on your PC) ---

# Ollama — https://ollama.com/download
# RTX 4070 Super (12 GB): use qwen2.5-coder:14b as default; 7b = faster; 32b = slower but smarter
# One-shot: pnpm run setup:models
# Use 127.0.0.1 (not localhost) to avoid Windows IPv6 issues
OLLAMA_API_BASE_URL=http://127.0.0.1:11434

# LM Studio — optional; enable CORS in LM Studio settings
LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234

# OpenAI-compatible local servers (llama.cpp, vLLM, text-generation-webui, etc.)
# OPENAI_LIKE_API_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_LIKE_API_KEY=not-needed

# Context window for local models (tokens)
DEFAULT_NUM_CTX=32768

# --- Optional cloud free/cheap (no OpenAI/Anthropic required) ---

# Hugging Face Inference Providers (free token at https://huggingface.co/settings/tokens)
# Token needs "Inference Providers" permission (Fine-grained token recommended).
# HuggingFace_API_KEY=hf_your_token_here
# HuggingFace_API_BASE_URL=https://router.huggingface.co/v1
