# LUXCode — free local AI on Windows (browser)
# Copy to .env.local:  copy .env.free-local.example .env.local
#
# Recommended: OmniRoute gateway (Cursor-style) + Ollama for fully local models.
# Hugging Face is optional (free tier with a token from huggingface.co/settings/tokens).

NODE_ENV=development
PORT=5173
VITE_LOG_LEVEL=info

# --- Reges harness (default when reachable) - RegesCore-Ai gateway ---
# OpenAI-compatible; models: reges, reges/auto-cheap|balanced|best, reges/local/<id>.
# Any key works on the Reges machine; from another machine use an rg_ token.
# REGES_MODE=plain (default: luxCoder's own prompt only) or harness (Reges tools + reasoning).
REGES_API_BASE_URL=http://127.0.0.1:3000/v1
REGES_API_KEY=reges
REGES_MODE=plain

# --- OmniRoute (fallback) — npm install -g omniroute && omniroute ---
# Dashboard: http://127.0.0.1:20128 — create API key under Endpoints
# Routes Ollama, cloud APIs, smart fallback, token compression — one endpoint for luxCoder
OMNIROUTE_API_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=luxcoder-local

# --- Direct Ollama (fallback / when OmniRoute offline) ---

# Ollama — https://ollama.com/download
# RTX 4070 Super (12 GB): Lite profile uses 7b; Balanced uses 14b
# One-shot: pnpm run setup:models
OLLAMA_API_BASE_URL=http://127.0.0.1:11434

# LM Studio — optional; enable CORS in LM Studio settings
LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234

# Context window for direct Ollama (tokens) — Lite profile default is 8192
DEFAULT_NUM_CTX=8192

# --- Optional cloud free/cheap (routed via OmniRoute or direct) ---

# Hugging Face Inference Providers (free token at https://huggingface.co/settings/tokens)
# HuggingFace_API_KEY=hf_your_token_here
# HuggingFace_API_BASE_URL=https://router.huggingface.co/v1
